@startuml

actor Usuari_General as Usuari
boundary InterficieMenuPrincipal as interficie
control gestor_comptes as gestor
entity DadesUsuariGeneral as dades

Usuari -> interficie ++: 1.1 confirmar_registre(contr, correu)
interficie -> gestor --++: 1.2 confirmar_registre(contr, correu)
gestor -> dades : 1.3 guardar_dades(contr, correu)
gestor -> interficie--: 1.4 mostrar_opcions_omplir()


loop fins que les dades siguin vàlides
Usuari -> interficie ++: 2.1 omplir_dades(dades)
ref over Usuari : CU OmplirCompteBancari
interficie -> gestor --++: 2.2 omplir_dades(dades)
gestor -> interficie : 2.alt NotificaError(errorOmplirPerfil)
end
gestor -> dades : guardar_dades_perfil(dades)
gestor -> interficie --: 2.3 missatgeConfimacio(OmplirPerfil)
@enduml