@startuml
actor Cuiner
boundary InterfíciePlat
control GestorPlat
entity Plat
entity Ingredient

loop fins que el cuiner deixi d'afegir plats

Cuiner -> InterfíciePlat++: CrearNouPlat()
InterfíciePlat -> GestorPlat--++: nouPlat = CrearNouPlat(c)
GestorPlat -> Plat: nouPlat = plat(c)
GestorPlat --> InterfíciePlat--
...
loop fins que el nom no sigui igual
Cuiner -> InterfíciePlat++: AfegirInformació(n,d)
InterfíciePlat -> GestorPlat--++: ConsultarNomIguals(nouPlat,n)
GestorPlat -> Plat: getNom()
Plat-->GestorPlat
Alt Nom igual
GestorPlat->InterfíciePlat: NotificarClient("Error: Nom igual")
end
end
GestorPlat--

InterfíciePlat -> GestorPlat--++: AfegirInformació(nouPlat,n,d)
GestorPlat -> Plat: AfegirInformació(n,d)
GestorPlat--

loop fins que el cuiner deixi d'afegir imatges
Cuiner -> InterfíciePlat++: AfegirImatge(img)
InterfíciePlat -> GestorPlat--++: AfegirImatge(nouPlat,img)
GestorPlat -> Plat: AfegirImatge(img)
GestorPlat--
end

...
Cuiner -> InterfíciePlat++: AfegirIngredients(Ings)
InterfíciePlat -> GestorPlat--++: AfegirIngredients(nouPlat,Ings)
GestorPlat->Plat++: AfegirIngredients(Ings)
 loop
   Plat->Ingredient: GetDades(i)
   Ingredient-->Plat
 end
 Plat-->GestorPlat--
 GestorPlat->InterfíciePlat--: NotificarCuiner("Ok!")
end
@enduml